<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>INDEX · 코인 대시 &amp; 장애물 회피</title>
  <style>
    :root {
      --bg: #090e1a;
      --surface: #121b30;
      --surface-2: #1a2744;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-hover: #0ea5e9;
      --coin: #fbbf24;
      --hazard: #fb7185;
      --player: #34d399;
      --dash: #a78bfa;
      --border: #2a3c63;
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
      background: radial-gradient(circle at top, #162340 0%, var(--bg) 62%);
      color: var(--text);
      min-height: 100vh;
      padding: 20px 14px 48px;
      line-height: 1.5;
    }

    .app {
      max-width: 820px;
      margin: 0 auto;
      display: grid;
      gap: 16px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
    }

    .game-title {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .game-sub {
      font-size: 0.88rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .index-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .index-nav a {
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--muted);
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 5px 10px;
      border-radius: 8px;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .index-nav a:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    .hud-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    @media (max-width: 640px) {
      .hud-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .hud-box {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 6px;
    }

    .hud-label {
      font-size: 0.74rem;
      color: var(--muted);
      font-weight: 700;
    }

    .hud-val {
      font-size: 1.2rem;
      font-weight: 800;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .hud-val.accent { color: var(--accent); }
    .hud-val.coin { color: var(--coin); }
    .hud-val.hazard { color: var(--hazard); }
    .hud-val.dash { color: var(--dash); }

    .cooldown-track {
      width: 100%;
      height: 8px;
      background: #0b1120;
      border: 1px solid var(--border);
      border-radius: 999px;
      overflow: hidden;
    }

    .cooldown-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, #8b5cf6, #38bdf8);
      border-radius: 999px;
      transition: width 0.05s linear;
    }

    .cooldown-fill.cooling {
      background: #64748b;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .diff-group {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .diff-btn {
      background: var(--surface-2);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 6px 11px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
    }

    .diff-btn.active {
      background: rgba(56, 189, 248, 0.16);
      color: var(--accent);
      border-color: var(--accent);
    }

    .action-group {
      display: flex;
      gap: 8px;
    }

    .btn {
      background: var(--accent);
      color: #061322;
      border: none;
      padding: 8px 15px;
      border-radius: 9px;
      font-size: 0.86rem;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .btn:hover:not(:disabled) {
      background: var(--accent-hover);
    }

    .btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .btn-ghost {
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover:not(:disabled) {
      border-color: var(--accent);
    }

    .stage-wrap {
      position: relative;
      width: 100%;
      height: 420px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: #070b14;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    .key-hint {
      margin-top: 10px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.82rem;
      color: var(--muted);
    }

    kbd {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 1px 6px;
      font-size: 0.78rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--text);
    }

    .overlay {
      position: absolute;
      inset: 0;
      background: rgba(7, 11, 20, 0.84);
      backdrop-filter: blur(3px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px;
      gap: 10px;
    }

    .overlay.hidden {
      display: none;
    }

    .overlay h2 {
      font-size: 1.45rem;
      font-weight: 800;
    }

    .overlay p {
      color: var(--muted);
      font-size: 0.92rem;
      max-width: 420px;
    }

    .final-score {
      font-size: 1.8rem;
      font-weight: 900;
      color: var(--coin);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    h3 {
      font-size: 1rem;
      margin-bottom: 8px;
    }

    .rules {
      padding-left: 18px;
      color: var(--muted);
      font-size: 0.88rem;
      display: grid;
      gap: 5px;
    }

    .rules code {
      color: var(--text);
      background: var(--surface-2);
      padding: 1px 6px;
      border-radius: 5px;
    }
  </style>
</head>
<body>
  <main class="app">
    <header id="top-index" class="card">
      <h1 class="game-title">INDEX · 코인 대시 &amp; 장애물 회피</h1>
      <p class="game-sub">방향키/WASD로 이동하고 Shift 또는 Space로 순간 대시해 장애물을 피하며 코인을 모으세요.</p>
      <nav class="index-nav" aria-label="게임 섹션 인덱스">
        <a href="#top-index">[00] 최상단 INDEX</a>
        <a href="#game-hud">[01] HUD</a>
        <a href="#game-stage">[02] 게임 스테이지</a>
        <a href="#game-guide">[03] 규칙 및 배포</a>
      </nav>
    </header>

    <section id="game-hud" class="card" aria-label="점수 및 상태">
      <div class="hud-grid">
        <div class="hud-box">
          <div class="hud-label">SCORE</div>
          <div id="hudScore" class="hud-val accent">0</div>
        </div>
        <div class="hud-box">
          <div class="hud-label">COINS</div>
          <div id="hudCoins" class="hud-val coin">0</div>
        </div>
        <div class="hud-box">
          <div class="hud-label">SPEED LV</div>
          <div id="hudLevel" class="hud-val hazard">Lv.1</div>
        </div>
        <div class="hud-box">
          <div>
            <div class="hud-label">DASH COOLDOWN</div>
            <div id="hudDashText" class="hud-val dash">READY</div>
          </div>
          <div class="cooldown-track" aria-label="대시 쿨다운 게이지">
            <div id="hudDashBar" class="cooldown-fill"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="game-stage" class="card">
      <div class="toolbar">
        <div class="diff-group" role="group" aria-label="난이도 선택">
          <button class="diff-btn active" data-diff="normal" type="button">보통</button>
          <button class="diff-btn" data-diff="fast" type="button">빠름</button>
          <button class="diff-btn" data-diff="hyper" type="button">초고속</button>
        </div>
        <div class="action-group">
          <button id="pauseBtn" class="btn btn-ghost" type="button" disabled>일시정지</button>
          <button id="restartBtn" class="btn btn-ghost" type="button">재시작</button>
        </div>
      </div>

      <div class="stage-wrap">
        <canvas id="gameCanvas"></canvas>

        <div id="startOverlay" class="overlay">
          <h2>코인 대시 준비 완료</h2>
          <p><kbd>WASD</kbd> 또는 <kbd>방향키</kbd>로 이동하고, <kbd>Shift</kbd> 또는 <kbd>Space</kbd>로 순간 대시하여 장애물을 피하세요.</p>
          <button id="startBtn" class="btn" type="button">게임 시작</button>
        </div>

        <div id="pauseOverlay" class="overlay hidden">
          <h2>일시정지</h2>
          <p>계속하려면 아래 버튼을 누르세요.</p>
          <button id="resumeBtn" class="btn" type="button">계속하기</button>
        </div>

        <div id="overOverlay" class="overlay hidden">
          <h2>충돌! 게임 오버</h2>
          <div id="finalScoreText" class="final-score">0점</div>
          <p id="overSummary">획득 코인 0개 · 생존 시간 0.0초</p>
          <button id="playAgainBtn" class="btn" type="button">다시 플레이</button>
        </div>
      </div>

      <div class="key-hint">
        <span>이동: <kbd>WASD</kbd> / <kbd>방향키</kbd> · 순간 대시: <kbd>Shift</kbd> / <kbd>Space</kbd></span>
        <span>일시정지: <kbd>P</kbd> / <kbd>Esc</kbd></span>
      </div>
    </section>

    <footer id="game-guide" class="card">
      <h3>대시 스킬, 조작법 및 GitHub Pages 배포</h3>
      <ul class="rules">
        <li><strong>순간 대시(<code>Shift</code> / <code>Space</code>):</strong> 입력 방향으로 약 <code>115px</code> 짧게 순간 이동하며, 대시 직후 <code>0.28초</code> 동안 <strong>무적 상태</strong>가 되어 장애물을 통과할 수 있습니다.</li>
        <li><strong>쿨다운 게이지:</strong> 대시 재사용 대기시간은 <code>1.8초</code>이며, HUD 게이지가 100% 차오르면 다시 사용할 수 있습니다.</li>
        <li><strong>404 방지 팁:</strong> 저장소 루트에 <code>index.html</code>(소문자)로 업로드하거나, 하위 폴더에 둘 경우 해당 폴더 경로(예: <code>./GAME/index.html</code>)가 실제 파일 위치와 일치해야 합니다.</li>
      </ul>
    </footer>
  </main>

  <script>
    const DIFF_CONFIG = {
      normal: {
        playerSpeed: 290,
        hazardSpeedMin: 145,
        hazardSpeedMax: 235,
        hazardInterval: 760,
        coinInterval: 950,
        scoreMult: 1.0
      },
      fast: {
        playerSpeed: 325,
        hazardSpeedMin: 200,
        hazardSpeedMax: 315,
        hazardInterval: 540,
        coinInterval: 850,
        scoreMult: 1.3
      },
      hyper: {
        playerSpeed: 360,
        hazardSpeedMin: 265,
        hazardSpeedMax: 400,
        hazardInterval: 390,
        coinInterval: 780,
        scoreMult: 1.6
      }
    };

    const DASH_DISTANCE = 115;
    const DASH_COOLDOWN = 1.8;
    const DASH_INVULN_DURATION = 0.28;
    const BEST_KEY = "coin_dodge_arcade_best_v1";

    function loadBestScore() {
      try {
        return Number(localStorage.getItem(BEST_KEY) || "0") || 0;
      } catch {
        return 0;
      }
    }

    function saveBestScore(value) {
      try {
        localStorage.setItem(BEST_KEY, String(value));
      } catch {
        // 스토리지 제한 환경 무시
      }
    }

    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    const hudScore = document.getElementById("hudScore");
    const hudCoins = document.getElementById("hudCoins");
    const hudLevel = document.getElementById("hudLevel");
    const hudDashText = document.getElementById("hudDashText");
    const hudDashBar = document.getElementById("hudDashBar");

    const startOverlay = document.getElementById("startOverlay");
    const pauseOverlay = document.getElementById("pauseOverlay");
    const overOverlay = document.getElementById("overOverlay");
    const finalScoreText = document.getElementById("finalScoreText");
    const overSummary = document.getElementById("overSummary");

    const startBtn = document.getElementById("startBtn");
    const pauseBtn = document.getElementById("pauseBtn");
    const resumeBtn = document.getElementById("resumeBtn");
    const restartBtn = document.getElementById("restartBtn");
    const playAgainBtn = document.getElementById("playAgainBtn");
    const diffBtns = Array.from(document.querySelectorAll(".diff-btn"));

    let difficulty = "normal";
    let state = "idle";
    let score = 0;
    let coinsCollected = 0;
    let surviveTime = 0;
    let speedLevel = 1;
    let bestScore = loadBestScore();

    let dashCooldownLeft = 0;
    let dashInvulnLeft = 0;

    const keys = new Set();
    const player = { x: 0, y: 0, radius: 15, lastDirX: 0, lastDirY: -1 };
    let hazards = [];
    let coins = [];
    let popups = [];
    let afterimages = [];
    let hazardTimer = 0;
    let coinTimer = 0;
    let survivalScoreAcc = 0;
    let lastFrameTime = 0;

    function clampPlayer() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      const pad = player.radius + 6;
      player.x = Math.max(pad, Math.min(w - pad, player.x));
      player.y = Math.max(pad, Math.min(h - pad, player.y));
    }

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (state === "idle") {
        player.x = canvas.clientWidth * 0.5;
        player.y = canvas.clientHeight * 0.78;
      } else {
        clampPlayer();
      }
    }

    function updateHud() {
      hudScore.textContent = Math.floor(score).toLocaleString("ko-KR");
      hudCoins.textContent = coinsCollected.toLocaleString("ko-KR");
      hudLevel.textContent = `Lv.${speedLevel}`;

      if (dashCooldownLeft <= 0) {
        hudDashText.textContent = "READY";
        hudDashBar.style.width = "100%";
        hudDashBar.classList.remove("cooling");
      } else {
        hudDashText.textContent = `${dashCooldownLeft.toFixed(1)}s`;
        const progress = Math.max(0, Math.min(100, ((DASH_COOLDOWN - dashCooldownLeft) / DASH_COOLDOWN) * 100));
        hudDashBar.style.width = `${progress}%`;
        hudDashBar.classList.add("cooling");
      }
    }

    function resetGame() {
      score = 0;
      coinsCollected = 0;
      surviveTime = 0;
      speedLevel = 1;
      dashCooldownLeft = 0;
      dashInvulnLeft = 0;
      survivalScoreAcc = 0;
      hazards = [];
      coins = [];
      popups = [];
      afterimages = [];
      hazardTimer = 0;
      coinTimer = 0;
      player.x = canvas.clientWidth * 0.5;
      player.y = canvas.clientHeight * 0.78;
      player.lastDirX = 0;
      player.lastDirY = -1;
      updateHud();
    }

    function startGame() {
      resetGame();
      state = "playing";
      lastFrameTime = performance.now();
      startOverlay.classList.add("hidden");
      pauseOverlay.classList.add("hidden");
      overOverlay.classList.add("hidden");
      pauseBtn.disabled = false;
      pauseBtn.textContent = "일시정지";
      spawnCoin();
      spawnHazard();
    }

    function togglePause() {
      if (state === "playing") {
        state = "paused";
        pauseOverlay.classList.remove("hidden");
        pauseBtn.textContent = "재개";
      } else if (state === "paused") {
        state = "playing";
        lastFrameTime = performance.now();
        pauseOverlay.classList.add("hidden");
        pauseBtn.textContent = "일시정지";
      }
    }

    function gameOver() {
      state = "over";
      pauseBtn.disabled = true;
      const finalInt = Math.floor(score);
      if (finalInt > bestScore) {
        bestScore = finalInt;
        saveBestScore(bestScore);
      }
      updateHud();
      finalScoreText.textContent = `${finalInt.toLocaleString("ko-KR")}점`;
      overSummary.textContent = `획득 코인 ${coinsCollected}개 · 생존 시간 ${surviveTime.toFixed(1)}초 · 최고 기록 ${bestScore.toLocaleString("ko-KR")}점`;
      overOverlay.classList.remove("hidden");
    }

    function getCurrentInputVector() {
      let dx = 0;
      let dy = 0;
      if (keys.has("ArrowLeft") || keys.has("KeyA")) dx -= 1;
      if (keys.has("ArrowRight") || keys.has("KeyD")) dx += 1;
      if (keys.has("ArrowUp") || keys.has("KeyW")) dy -= 1;
      if (keys.has("ArrowDown") || keys.has("KeyS")) dy += 1;

      if (dx !== 0 && dy !== 0) {
        const inv = 1 / Math.SQRT2;
        dx *= inv;
        dy *= inv;
      }
      return { dx, dy };
    }

    function triggerDash() {
      if (state !== "playing" || dashCooldownLeft > 0) return;

      const { dx, dy } = getCurrentInputVector();
      let dirX = dx;
      let dirY = dy;
      if (dirX === 0 && dirY === 0) {
        dirX = player.lastDirX;
        dirY = player.lastDirY;
      }

      const startX = player.x;
      const startY = player.y;

      for (let i = 0; i < 4; i++) {
        const ratio = i / 4;
        afterimages.push({
          x: startX + dirX * DASH_DISTANCE * ratio,
          y: startY + dirY * DASH_DISTANCE * ratio,
          radius: player.radius,
          alpha: 0.55 - ratio * 0.1
        });
      }

      player.x += dirX * DASH_DISTANCE;
      player.y += dirY * DASH_DISTANCE;
      clampPlayer();

      dashCooldownLeft = DASH_COOLDOWN;
      dashInvulnLeft = DASH_INVULN_DURATION;
      addPopup(player.x, player.y - 14, "DASH!", "#a78bfa");
      updateHud();
    }

    function spawnHazard() {
      const cfg = DIFF_CONFIG[difficulty];
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      const radius = 13 + Math.random() * 11;
      const levelBoost = 1 + (speedLevel - 1) * 0.1;
      const speed = (cfg.hazardSpeedMin + Math.random() * (cfg.hazardSpeedMax - cfg.hazardSpeedMin)) * levelBoost;

      const fromSide = Math.random() < 0.28;
      if (!fromSide) {
        const x = radius + 12 + Math.random() * Math.max(20, w - (radius + 12) * 2);
        const vx = (Math.random() - 0.5) * 65;
        hazards.push({ x, y: -radius - 6, vx, vy: speed, radius, rot: 0, vRot: (Math.random() - 0.5) * 6 });
      } else {
        const leftSide = Math.random() < 0.5;
        const x = leftSide ? -radius - 6 : w + radius + 6;
        const y = radius + 24 + Math.random() * Math.max(40, h * 0.65);
        const vx = (leftSide ? 1 : -1) * speed * 0.85;
        const vy = speed * 0.45;
        hazards.push({ x, y, vx, vy, radius, rot: 0, vRot: (Math.random() - 0.5) * 6 });
      }
    }

    function spawnCoin() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      const radius = 11;
      const pad = radius + 22;
      const x = pad + Math.random() * Math.max(20, w - pad * 2);
      const y = pad + Math.random() * Math.max(20, h - pad * 2);
      coins.push({ x, y, radius, ttl: 8.5, pulse: 0 });
    }

    function addPopup(x, y, text, color) {
      popups.push({ x, y, text, color, alpha: 1, vy: -30 });
    }

    window.addEventListener("keydown", (e) => {
      const code = e.code;
      if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Space"].includes(code)) {
        e.preventDefault();
      }

      if (code === "Escape" || code === "KeyP") {
        if (state === "playing" || state === "paused") {
          togglePause();
        }
        return;
      }

      if ((code === "ShiftLeft" || code === "ShiftRight" || code === "Space") && !e.repeat) {
        triggerDash();
      }

      keys.add(code);
    });

    window.addEventListener("keyup", (e) => {
      keys.delete(e.code);
    });

    function update(dtMs) {
      const dt = dtMs / 1000;
      const cfg = DIFF_CONFIG[difficulty];

      surviveTime += dt;
      speedLevel = 1 + Math.floor(surviveTime / 10);

      if (dashCooldownLeft > 0) {
        dashCooldownLeft = Math.max(0, dashCooldownLeft - dt);
      }
      if (dashInvulnLeft > 0) {
        dashInvulnLeft = Math.max(0, dashInvulnLeft - dt);
      }

      survivalScoreAcc += dt * 35 * cfg.scoreMult * (1 + (speedLevel - 1) * 0.15);
      if (survivalScoreAcc >= 1) {
        const add = Math.floor(survivalScoreAcc);
        score += add;
        survivalScoreAcc -= add;
      }

      const { dx, dy } = getCurrentInputVector();
      if (dx !== 0 || dy !== 0) {
        player.lastDirX = dx;
        player.lastDirY = dy;
      }

      player.x += dx * cfg.playerSpeed * dt;
      player.y += dy * cfg.playerSpeed * dt;
      clampPlayer();

      const spawnScale = Math.max(0.52, 1 - (speedLevel - 1) * 0.06);
      hazardTimer += dtMs;
      if (hazardTimer >= cfg.hazardInterval * spawnScale) {
        hazardTimer = 0;
        spawnHazard();
      }

      coinTimer += dtMs;
      if (coinTimer >= cfg.coinInterval && coins.length < 4) {
        coinTimer = 0;
        spawnCoin();
      }

      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      for (let i = hazards.length - 1; i >= 0; i--) {
        const hz = hazards[i];
        hz.x += hz.vx * dt;
        hz.y += hz.vy * dt;
        hz.rot += hz.vRot * dt;

        if (dashInvulnLeft <= 0) {
          const dist = Math.hypot(player.x - hz.x, player.y - hz.y);
          if (dist < player.radius + hz.radius - 3) {
            gameOver();
            return;
          }
        }

        if (hz.y - hz.radius > h + 40 || hz.x < -80 || hz.x > w + 80) {
          hazards.splice(i, 1);
        }
      }

      for (let i = coins.length - 1; i >= 0; i--) {
        const c = coins[i];
        c.ttl -= dt;
        c.pulse += dt * 5;

        const dist = Math.hypot(player.x - c.x, player.y - c.y);
        if (dist <= player.radius + c.radius + 2) {
          coinsCollected += 1;
          const gained = Math.round(150 * cfg.scoreMult);
          score += gained;
          addPopup(c.x, c.y - 8, `+${gained}`, "#fbbf24");
          coins.splice(i, 1);
          continue;
        }

        if (c.ttl <= 0) {
          coins.splice(i, 1);
        }
      }

      for (let i = afterimages.length - 1; i >= 0; i--) {
        afterimages[i].alpha -= dt * 2.6;
        if (afterimages[i].alpha <= 0) {
          afterimages.splice(i, 1);
        }
      }

      for (let i = popups.length - 1; i >= 0; i--) {
        const p = popups[i];
        p.y += p.vy * dt;
        p.alpha -= dt * 1.3;
        if (p.alpha <= 0) {
          popups.splice(i, 1);
        }
      }

      updateHud();
    }

    function draw() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);

      ctx.strokeStyle = "rgba(148, 163, 184, 0.06)";
      ctx.lineWidth = 1;
      for (let x = 40; x < w; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      for (let y = 40; y < h; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      for (const img of afterimages) {
        ctx.beginPath();
        ctx.arc(img.x, img.y, img.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(167, 139, 250, ${Math.max(0, img.alpha) * 0.45})`;
        ctx.fill();
      }

      for (const c of coins) {
        const r = c.radius + Math.sin(c.pulse) * 1.4;
        ctx.beginPath();
        ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(251, 191, 36, 0.22)";
        ctx.fill();
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = "#fbbf24";
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(c.x, c.y, r * 0.45, 0, Math.PI * 2);
        ctx.fillStyle = "#fde68a";
        ctx.fill();
      }

      for (const hz of hazards) {
        ctx.save();
        ctx.translate(hz.x, hz.y);
        ctx.rotate(hz.rot);
        const s = hz.radius;

        ctx.beginPath();
        ctx.moveTo(0, -s);
        ctx.lineTo(s, 0);
        ctx.lineTo(0, s);
        ctx.lineTo(-s, 0);
        ctx.closePath();

        ctx.fillStyle = "rgba(251, 113, 133, 0.24)";
        ctx.fill();
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = "#fb7185";
        ctx.stroke();
        ctx.restore();
      }

      const isInvuln = dashInvulnLeft > 0;
      if (isInvuln) {
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius + 6, 0, Math.PI * 2);
        ctx.strokeStyle = "rgba(167, 139, 250, 0.85)";
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      ctx.beginPath();
      ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
      ctx.fillStyle = isInvuln ? "rgba(167, 139, 250, 0.35)" : "rgba(52, 211, 153, 0.25)";
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = isInvuln ? "#a78bfa" : "#34d399";
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(player.x, player.y, 5, 0, Math.PI * 2);
      ctx.fillStyle = "#ffffff";
      ctx.fill();

      ctx.font = "800 13px ui-monospace, SFMono-Regular, Menlo, monospace";
      ctx.textAlign = "center";
      for (const p of popups) {
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        ctx.fillText(p.text, p.x, p.y);
      }
      ctx.globalAlpha = 1;
    }

    function loop(now) {
      if (state === "playing") {
        const dt = Math.min(100, now - lastFrameTime);
        lastFrameTime = now;
        update(dt);
      }
      draw();
      requestAnimationFrame(loop);
    }

    diffBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        diffBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        difficulty = btn.dataset.diff;
        if (state === "playing") {
          startGame();
        }
      });
    });

    startBtn.addEventListener("click", startGame);
    playAgainBtn.addEventListener("click", startGame);
    restartBtn.addEventListener("click", startGame);
    pauseBtn.addEventListener("click", togglePause);
    resumeBtn.addEventListener("click", togglePause);

    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();
    updateHud();
    requestAnimationFrame(loop);
  </script>
</body>
</html>
